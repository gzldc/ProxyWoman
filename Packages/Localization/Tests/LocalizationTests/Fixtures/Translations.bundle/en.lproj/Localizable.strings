"rules.upgrade.introUnlisted" = "The way rules run has been upgraded. %1$ld pair(s) of rules may now behave differently from before, but these pairs are not listed. Other rules behave as before.";
"rules.upgrade.class1.title" = "Return File (Map Local) and Map Local Directory are now final actions";
"rules.upgrade.class1.body" = "Once it matches, rules with a lower priority no longer apply to that traffic; rules with a higher priority still do.";
"rules.upgrade.class2.title" = "A rule’s conditions now read the rewritten request or status code";
"rules.upgrade.class2.body" = "When a rule’s conditions are checked, they read the request or status code as another rule has already rewritten it, not the original. For example, after a Map Remote changes the host, a rule that matches the original host may no longer match; after a status rewrite, a rule with a status range reads the new status. In each pair listed, one rule makes a change and the conditions of the other read the result.";
"rules.upgrade.class3.title" = "Several rules that rewrite or map the same target (Map Local Directory included) now run in turn";
"rules.upgrade.class3.body" = "Two status rewrites: the second overrides the first. Two Map Remotes: the second continues from the address the first produced. A Map Remote followed by a Map Local or a Map Local Directory: both run, and the local file or the file from the directory is returned. Before, only the first one took effect and the others were ignored.";
"rules.upgrade.pair" = "“%1$@” → “%2$@”";
"rules.upgrade.omitted" = "%1$ld more affected pair(s) are not listed here.";
"rules.upgrade.advice" = "What to do: for a pair in the list, if the affected rule comes second, move it above the other one so it runs first; or change the affected rule’s conditions to match the rewritten target. A rule with a status range is judged when the response arrives, so moving it does not change the request it reads; change its conditions instead.";
"rules.upgrade.acknowledge" = "Got It";
"rules.upgrade.reopen" = "View Upgrade Notes";
"rules.upgrade.banner" = "Rules 2.0 changes how some of your rules behave.";
