<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>flow.count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@flows@</string>
		<key>flows</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d flow</string>
			<key>other</key>
			<string>%d flows</string>
		</dict>
	</dict>
	<key>statusBar.selectedRows</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@rows@; %1$#@selected@</string>
		<key>rows</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld row</string>
			<key>other</key>
			<string>%ld rows</string>
		</dict>
		<key>selected</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld selected item</string>
			<key>other</key>
			<string>%ld selected items</string>
		</dict>
	</dict>
	<key>quickFilterBar.moreFiltersCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@filters@</string>
		<key>filters</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld extra filter</string>
			<key>other</key>
			<string>%ld extra filters</string>
		</dict>
	</dict>
	<key>rawMessage.binaryBody</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>&lt;%#@bytes@ binary&gt;</string>
		<key>bytes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld byte</string>
			<key>other</key>
			<string>%ld bytes</string>
		</dict>
	</dict>
	<key>hexDump.truncated</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>truncated: %#@bytes@</string>
		<key>bytes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld byte</string>
			<key>other</key>
			<string>%ld bytes</string>
		</dict>
	</dict>
	<key>imagePreview.pixelDimensions</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@height@ high × %1$#@width@ wide</string>
		<key>height</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld pixel</string>
			<key>other</key>
			<string>%ld pixels</string>
		</dict>
		<key>width</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld pixel</string>
			<key>other</key>
			<string>%ld pixels</string>
		</dict>
	</dict>
	<key>advancedPane.deletionLimits</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%4$@ cache (%3$#@bytes@); %2$@ requests (%1$#@flows@)</string>
		<key>bytes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld byte</string>
			<key>other</key>
			<string>%ld bytes</string>
		</dict>
		<key>flows</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld flow</string>
			<key>other</key>
			<string>%ld flows</string>
		</dict>
	</dict>
